{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [".opencode/plugins/session-context.js", ".opencode/plugins/roleflow.js"],
  "mcp": {
    "build-mcp": {
      "type": "local",
      "command": ["python3", "tools/mcp_build_wrapper.py"],
      "cwd": "/home/snow/asterinas",
      "enabled": true,
      "timeout": 3600000
    },
    "serial-mcp": {
      "type": "local",
      "command": ["python3", "tools/mcp_serial_wrapper.py"],
      "cwd": "/home/snow/asterinas",
      "enabled": true,
      "timeout": 3600000
    }
  }
}
